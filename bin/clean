#!/bin/bash
# Command to clean up root partition

# Remove leftover download-* temp dirs from interrupted downloads; otherwise
# `pacman -Sc` fails on them with "could not open file ... Error reading fd"
if [[ ! -e /var/lib/pacman/db.lck ]]; then
    sudo find /var/cache/pacman/pkg -maxdepth 1 -type d -name 'download-*' -mmin +60 -exec rm -rf {} +
fi

# Remove all the cached packages that are not currently installed, and the unused sync databases
# https://wiki.archlinux.org/title/Pacman
sudo pacman -Sc

# For recursively removing orphans and their configuration files
# https://wiki.archlinux.org/title/Pacman/Tips_and_tricks 
mapfile -t orphans < <(pacman -Qdtq)
if (( ${#orphans[@]} )); then
    sudo pacman -Rns "${orphans[@]}"
else
    echo "No orphan packages to remove"
fi

# Repair a flatpak installation by pruning and reinstalling invalid objects.
# https://man.archlinux.org/man/flatpak-repair.1.en
if command -v flatpak &> /dev/null; then
    sudo flatpak repair
fi

# Remove all unused containers, networks, images
# https://docs.podman.io/en/latest/markdown/podman-system-prune.1.html
for engine in podman docker; do
    if command -v "$engine" &> /dev/null; then
        "$engine" system prune
    fi
done
