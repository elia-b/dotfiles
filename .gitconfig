# User name/email live in ~/.gitconfig.local (not committed), e.g.:
#   [user]
#       name = ...
#       email = ...
[include]
	path = ~/.gitconfig.local

[init]
	defaultBranch = main

[color]
	ui = auto

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
